/**
 * หางปลา × อุปกรณ์ (Lug Guide) — which crimp terminal (หางปลา) fits which device terminal.
 *   T = หางปลา (one per Item stock CODE): k type, wire sizes, screw/blade size, dimensions, catalog reference, confidence
 *   F = กลุ่มขั้วต่อของอุปกรณ์: cn connection type (open/captive/fork/box/plate/push/stud/none), screw, wire range a–b mm²,
 *       max lug width w, ov = manual overrides { lugCODE: [0|1|2, note] }
 *   D = อุปกรณ์ (Item stock CODE) → one or more F (a relay lists its sockets)
 * Whether a lug fits is worked out in the page from these values (zqLugFit), so editing a value updates every result.
 * Sheet LugGuide (main spreadsheet): KIND | KEY | DATA (JSON) | UPDATED | BY. Empty sheet = the catalog data below
 * (LUG_SEED, checked 11/2026); the first Admin save copies it into the sheet. Everyone reads; Admin edits.
 */
var LUG_SHEET = 'LugGuide', LUG_HEAD = ['KIND', 'KEY', 'DATA', 'UPDATED', 'BY'], LUG_CK = 'lug_v1';
var LUG_NUM = ['W', 'L', 't', 'd1', 'd2', 'D', 'F', 'a', 'b', 'w'];

function lugSheet_() { return sheet_(LUG_SHEET, LUG_HEAD); }
function lugRows_() {
  var sh = lugSheet_(), n = sh.getLastRow() - 1;
  return n > 0 ? sh.getRange(2, 1, n, 3).getValues().filter(function (r) { return r[0] && r[1]; }) : [];
}
function lugRead_() {
  var C = CacheService.getScriptCache(), hit = C.get(LUG_CK);
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  var rows = lugRows_(), out;
  if (!rows.length) out = { T: LUG_SEED.T, F: LUG_SEED.F, D: LUG_SEED.D, custom: false };
  else {
    out = { T: [], F: {}, D: [], custom: true };
    rows.forEach(function (r) {
      var o; try { o = JSON.parse(String(r[2] || '{}')); } catch (e) { return; }
      if (r[0] === 'T') out.T.push(o); else if (r[0] === 'F') out.F[String(r[1])] = o; else if (r[0] === 'D') out.D.push(o);
    });
  }
  out.TKN = LUG_SEED.TKN; out.CONN = LUG_SEED.CONN; out.CONNN = LUG_SEED.CONNN;
  try { var s = JSON.stringify(out); if (s.length < 99000) C.put(LUG_CK, s, 21600); } catch (e) {}
  return out;
}
function getLugGuide(token) { apiOnly_(); var o = lugRead_(); o.admin = isAdmin_(token); return o; }

function lugStr_(v, n) { return String(v == null ? '' : v).replace(/[\r\n\t]+/g, ' ').trim().substring(0, n); }
function lugCode_(v) { return lugStr_(v, 40).toUpperCase().replace(/\s+/g, ''); }
function lugClean_(kind, o, fams) {
  o = o || {};
  var x = {};
  if (kind === 'T') {
    x.id = lugCode_(o.id); if (!x.id) throw new Error('ใส่ CODE ของหางปลา');
    x.k = lugStr_(o.k, 10); if (!LUG_SEED.TKN[x.k]) throw new Error('เลือกชนิดหางปลา');
    ['m', 'b', 'ins', 'c', 'wire', 'rng', 'sc', 'ref', 'src', 'note'].forEach(function (k) { var v = lugStr_(o[k], k === 'src' ? 400 : 160); if (v) x[k] = v; });
    if (!x.wire) throw new Error('ใส่ขนาดสาย (sq) เช่น 1.5, 2.5');
  } else if (kind === 'F') {
    x.n = lugStr_(o.n, 120); if (!x.n) throw new Error('ใส่ชื่อกลุ่มขั้วต่อ');
    x.cn = lugStr_(o.cn, 10); if (!LUG_SEED.CONN[x.cn]) throw new Error('เลือกชนิดขั้วต่อ');
    ['sc', 'note', 'src'].forEach(function (k) { var v = lugStr_(o[k], k === 'note' ? 300 : 400); if (v) x[k] = v; });
    var ov = {}; Object.keys(o.ov || {}).slice(0, 200).forEach(function (c) {
      var v = o.ov[c] || [], s = Number(v[0]); if ([0, 1, 2].indexOf(s) >= 0) ov[lugCode_(c)] = [s, lugStr_(v[1], 120)];
    });
    if (Object.keys(ov).length) x.ov = ov;
  } else {
    x.it = lugCode_(o.it); if (!x.it) throw new Error('ใส่ CODE ของอุปกรณ์');
    var f = String(o.f || '').split(/[,\s]+/).filter(function (k) { return k; });
    if (!f.length) throw new Error('เลือกกลุ่มขั้วต่ออย่างน้อย 1 กลุ่ม');
    f.forEach(function (k) { if (!fams[k]) throw new Error('ไม่พบกลุ่มขั้วต่อ ' + k); });
    x.f = f.join(','); x.g = lugStr_(o.g, 60); x.ds = lugStr_(o.ds, 200); x.so = lugStr_(o.so, 80); x.pl = o.pl ? 1 : 0;
  }
  LUG_NUM.forEach(function (k) { if (o[k] === '' || o[k] == null) return; var v = Number(o[k]); if (isFinite(v) && v >= 0 && v < 1000) x[k] = Math.round(v * 100) / 100; });
  if (kind === 'F' && !(x.cn === 'none') && x.a != null && x.b != null && x.a > x.b) throw new Error('ขนาดสายต่ำสุดมากกว่าสูงสุด');
  x.cf = /^[ABC]$/.test(o.cf) ? o.cf : 'C';
  return x;
}
function lugKey_(kind, x, key) { return kind === 'T' ? x.id : kind === 'D' ? x.it : lugStr_(key, 30).toUpperCase().replace(/[^A-Z0-9_]/g, ''); }
// write the whole data set (first edit: the catalog data becomes the sheet)
function lugSeedSheet_(sh) {
  var who = 'ข้อมูลเริ่มต้น', t = nowStr_(), rows = [];
  LUG_SEED.T.forEach(function (o) { rows.push(['T', o.id, JSON.stringify(o), t, who]); });
  Object.keys(LUG_SEED.F).forEach(function (k) { rows.push(['F', k, JSON.stringify(LUG_SEED.F[k]), t, who]); });
  LUG_SEED.D.forEach(function (o) { rows.push(['D', o.it, JSON.stringify(o), t, who]); });
  var rg = sh.getRange(2, 1, rows.length, 5); fmtText_(rg); rg.setValues(rows);
}
// kind T | F | D · key = the old KEY when editing (a renamed CODE replaces its row) · F needs key (group id)
function saveLug(token, kind, obj, key) { apiOnly_();
  requireAdmin_(token);
  if (['T', 'F', 'D'].indexOf(kind) < 0) throw new Error('ชนิดข้อมูลไม่ถูกต้อง');
  var who = __admName || (typeof __user !== 'undefined' && __user && __user.n) || 'Admin', x, k;
  withLock_(function () {
    var sh = lugSheet_();
    if (sh.getLastRow() < 2) lugSeedSheet_(sh);
    var rows = sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues(), fams = {};
    rows.forEach(function (r) { if (r[0] === 'F') fams[String(r[1])] = 1; });
    x = lugClean_(kind, obj, fams);
    k = lugKey_(kind, x, (obj || {}).key || key);
    if (!k) throw new Error('ใส่รหัสกลุ่ม (A–Z, 0–9, _)');
    var old = String(key || '').toUpperCase(), at = -1, dup = -1;
    rows.forEach(function (r, i) { if (r[0] !== kind) return; var rk = String(r[1]).toUpperCase(); if (old && rk === old) at = i; if (rk === k) dup = i; });
    if (dup >= 0 && dup !== at) { if (old) throw new Error(k + ' มีอยู่แล้ว'); at = dup; }
    var row = [kind, k, JSON.stringify(x), nowStr_(), who], rg = at >= 0 ? sh.getRange(at + 2, 1, 1, 5) : sh.getRange(sh.getLastRow() + 1, 1, 1, 5);
    fmtText_(rg); rg.setValues([row]);
    CacheService.getScriptCache().remove(LUG_CK);
  });
  audit_([['Admin', 'บันทึกหางปลา × อุปกรณ์', kind + ' ' + k, kind === 'F' ? x.n : kind === 'T' ? (x.m || '') : x.f]]);
  return getLugGuide(token);
}
function deleteLug(token, kind, key) { apiOnly_();
  requireAdmin_(token);
  key = String(key || '').toUpperCase();
  var gone = false;
  withLock_(function () {
    var sh = lugSheet_();
    if (sh.getLastRow() < 2) lugSeedSheet_(sh);
    var rows = sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues();
    if (kind === 'F') rows.forEach(function (r) {
      if (r[0] !== 'D') return; var o = {}; try { o = JSON.parse(r[2]); } catch (e) {}
      if (String(o.f || '').split(',').indexOf(key) >= 0) throw new Error('ยังมีอุปกรณ์ ' + r[1] + ' ใช้กลุ่มนี้ – ย้ายอุปกรณ์ก่อนลบ');
    });
    for (var i = 0; i < rows.length; i++) if (rows[i][0] === kind && String(rows[i][1]).toUpperCase() === key) { sh.deleteRow(i + 2); gone = true; break; }
    CacheService.getScriptCache().remove(LUG_CK);
  });
  if (!gone) throw new Error('ไม่พบรายการนี้ (อาจถูกลบไปแล้ว)');
  audit_([['Admin', 'ลบหางปลา × อุปกรณ์', kind + ' ' + key, '']]);
  return getLugGuide(token);
}

